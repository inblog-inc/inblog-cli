{
  "name": "@inblog/cli",
  "version": "0.3.0",
  "description": "CLI tool for managing inblog.ai content",
  "bin": {
    "inblog": "./dist/bin/inblog.js"
  },
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "inblog",
    "cli",
    "blog",
    "cms",
    "content-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inblog-inc/inblog-cli"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
